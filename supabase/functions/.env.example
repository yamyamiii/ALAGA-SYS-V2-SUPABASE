# Local Edge Function configuration. Do not place real secret values here.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
INVITATION_REDIRECT_URL=http://127.0.0.1:5173/login

# Supabase provides project keys to hosted Edge Functions. For non-hosted local
# runtimes, configure the standard variables without committing their values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
